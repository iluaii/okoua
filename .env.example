# Address the server listens on
ADDR=:8080

# Alert source: alertsinua, sirenppua or mock (test data).
# If empty: alertsinua when a token is set, otherwise sirenppua (siren.pp.ua, a keyless community
# wrapper of the official Ukraine Alarm API; a stopgap without guarantees).
# Use mock to test notifications: its alerts change every couple of minutes.
ALERTS_SOURCE=

# alerts.in.ua token (https://alerts.in.ua/api-request). Server only, never in the client.
ALERTS_IN_UA_TOKEN=

# How often to poll the source. alerts.in.ua allows up to 12 requests per minute per IP.
POLL_INTERVAL=15s

# Directory with the site build (web/build). Empty: the server serves only the API.
STATIC_DIR=

# How often to fetch power outage schedules.
POWER_INTERVAL=5m

# Directory for the SQLite database (feedback). Relative to where the server runs.
DATA_DIR=var

# Contact for push services (Apple requires a real one): an https URL or an e-mail address.
VAPID_SUBJECT=

# Set to 1 when running behind our reverse proxy (Caddy), so rate limits use the
# client address from X-Forwarded-For. Never enable without a proxy: clients could spoof it.
TRUST_PROXY=

# OpenRouter API key for AI answers about news (https://openrouter.ai/keys). Server only.
# Empty: AI is disabled.
OPENROUTER_API_KEY=

# Models to try in order (comma-separated). Default: qwen/qwen3.7-flash, then google/gemma-4-26b-a4b-it
# (paid, about $0.00003 and $0.00007 per summary). For testing without a balance, free ones, e.g.
# google/gemma-4-26b-a4b-it:free,openrouter/free (the router picks any free model; tried twice).
AI_MODELS=

# Maximum model calls per day (answers are cached, so only new questions count).
# 1000 calls cost at most about $0.10. Also set a spending limit on the key in OpenRouter.
AI_DAILY_LIMIT=1000
